# Copy this file to `.env` (which IS gitignored) and fill in your real keys.
# DO NOT put real keys in this file — it's committed to git.
#
# evaluate_ragas.py and answer_eval.py auto-load .env from the project root
# if python-dotenv is installed (`pip install python-dotenv`).
#
# You only need to fill in keys for the providers you actually use.
# Recommended fallback chain: groq → mistral
# (combined plenty of free tokens/day)

# ─── Groq Cloud ─────────────────────────────────────────────────────────
# Free tier: 14,400 RPD on llama-3.1-8b-instant (500k TPD)
#            1,000 RPD on llama-3.3-70b-versatile (100k TPD)
# Sign up:   https://console.groq.com/keys
GROQ_API_KEY=

# ─── Mistral La Plateforme ─────────────────────────────────────────────
# Free tier: 1 RPS, 1B tokens/MONTH (~33M/day equivalent — generous)
# Sign up:   https://console.mistral.ai
MISTRAL_API_KEY=

# ─── OpenRouter (multi-provider gateway) ───────────────────────────────
# Free tier: 50 RPD on :free models (1000 RPD with $10 deposit)
# Gives access to Qwen 2.5 72B, DeepSeek, etc. via one key
# Sign up:   https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ─── Google Gemini (DEPRECATED — quota too small for full eval) ────────
# Free tier: ~20 RPD on gemini-2.5-flash. Avoid for production eval.
# Sign up:   https://aistudio.google.com/apikey
GEMINI_API_KEY=
